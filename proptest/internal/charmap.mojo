"""Unicode general categories as codepoint sets.

Port of `hypothesis.internal.charmap`. The data comes from
`charmap_data.mojo`, generated by `tools/gen_unicode.mojo`.
"""

from proptest.internal.charmap_data import CATEGORY_DATA
from proptest.internal.intervals import IntervalSet


def _parse_hex(s: StringSlice) raises -> UInt32:
    var v = UInt32(0)
    for b in s.as_bytes():
        var d: UInt32
        if b >= UInt8(ord("0")) and b <= UInt8(ord("9")):
            d = UInt32(b) - UInt32(ord("0"))
        elif b >= UInt8(ord("a")) and b <= UInt8(ord("f")):
            d = UInt32(b) - UInt32(ord("a")) + 10
        else:
            raise Error("bad hex digit in category data")
        v = v * 16 + d
    return v


def all_categories() -> List[String]:
    """The 30 two-letter general categories, e.g. `Lu`, `Nd`, `Zs`."""
    var out = List[String]()
    for line in CATEGORY_DATA.split("\n"):
        if line.byte_length() >= 2:
            out.append(String(line[byte=0:2]))
    return out^


def as_general_categories(cats: List[String]) raises -> List[String]:
    """Expand one-letter major categories (`L` means all of `Lu`, `Ll`, `Lt`,
    `Lm`, `Lo`) and check that every name is a real category."""
    var known = all_categories()
    var out = List[String]()
    for c in cats:
        var found = False
        for k in known:
            var matches = (k == c) or (c.byte_length() == 1 and k.startswith(c))
            if matches:
                found = True
                var dup = False
                for o in out:
                    if o == k:
                        dup = True
                if not dup:
                    out.append(k)
        if not found:
            raise Error(
                String(
                    "InvalidArgument: ", repr(c), " is not a Unicode category"
                )
            )
    return out^


def category_intervals(cats: List[String]) raises -> IntervalSet:
    """The codepoints in any of the given (two-letter) categories."""
    var ivs = List[Tuple[UInt32, UInt32]]()
    for line in CATEGORY_DATA.split("\n"):
        if line.byte_length() < 2:
            continue
        var name = String(line[byte=0:2])
        var wanted = False
        for c in cats:
            if c == name:
                wanted = True
        if not wanted:
            continue
        var first = True
        for tok in line.split(" "):
            if first:
                first = False
                continue
            if tok.byte_length() == 0:
                continue
            var dash = tok.find("-")
            if dash < 0:
                var v = _parse_hex(tok)
                ivs.append((v, v))
            else:
                ivs.append(
                    (
                        _parse_hex(tok[byte=0:dash]),
                        _parse_hex(tok[byte = dash + 1 :]),
                    )
                )
    return IntervalSet(ivs^)
